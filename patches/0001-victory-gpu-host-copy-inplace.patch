+/// Whether a copy whose every source page is there is made in place instead
+/// of through the kernel (`VICTORY_COPY_PLAIN=0` turns it off, back to the
+/// kernel's read for every copy).
+fn plain_copies() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| {
+        !std::env::var_os("VICTORY_COPY_PLAIN").is_some_and(|v| v == "0")
+    })
+}
